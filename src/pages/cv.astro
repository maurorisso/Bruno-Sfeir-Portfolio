---
import Layout from "../layouts/Layout.astro";
---

<Layout title="CV - Bruno Sfeir">
  <main class="max-w-4xl mx-auto px-4 py-12">
    <div class="space-y-12">
      <!-- Bio Section -->
      <section class="prose prose-slate max-w-none">
        <h1 class="text-4xl font-light tracking-wide text-slate-800 mb-6">
          Curriculum Vitae
        </h1>
        <p class="text-slate-700 leading-relaxed">
          Bruno Sfeir, born on <span class="font-semibold">August 11, 1970</span
          >, in <span class="font-semibold">San José de Mayo, Uruguay</span>, is
          an accomplished artist whose work bridges tradition and modernity.
          Trained in <span class="font-semibold">Montevideo</span> and <span
            class="font-semibold">Brussels</span
          >, he has exhibited internationally, with solo shows in <span
            class="font-semibold">Beijing, Paris, Madrid</span
          >, and more. His art is featured in collections across South America,
          Europe, Asia, and the Middle East.
        </p>
      </section>

      <!-- Education Section -->
      <section>
        <h2
          class="text-2xl font-light text-slate-800 mb-4 border-b border-slate-200 pb-2"
        >
          Education
        </h2>
        <ul class="list-disc list-inside space-y-2 text-slate-700">
          <li>
            <span class="font-semibold">National School of Fine Arts</span>,
            Montevideo, Uruguay.
          </li>
          <li>
            <span class="font-semibold">Van Der Kelen Institute</span>,
            Brussels, Belgium.
          </li>
          <li>
            Studied with <span class="font-semibold">Master Dumas Oroño</span> and
            <span class="font-semibold">Master Clever Lara</span>.
          </li>
        </ul>
      </section>

      <!-- Awards Section -->
      <section>
        <h2
          class="text-2xl font-light text-slate-800 mb-4 border-b border-slate-200 pb-2"
        >
          Awards and Recognitions
        </h2>
        <ul class="list-disc list-inside space-y-2 text-slate-700">
          <li>
            <span class="font-semibold">1987:</span> Honorable Mention at the <span
              class="font-semibold">National Interior Salon</span
            >, "75 Years of Teatro Macció."
          </li>
          <li>
            <span class="font-semibold">1992:</span> Award from the <span
              class="font-semibold"
              >Bank of the Oriental Republic of Uruguay</span
            >.
          </li>
          <li>
            <span class="font-semibold">1997:</span> Award from the <span
              class="font-semibold">Ministry of Tourism of Uruguay</span
            >.
          </li>
        </ul>
      </section>

      <!-- Exhibitions Section -->
      <section>
        <h2
          class="text-2xl font-light text-slate-800 mb-4 border-b border-slate-200 pb-2"
        >
          Exhibitions
        </h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="space-y-3">
            <h3 class="text-xl font-medium text-slate-800">
              Recent Exhibitions
            </h3>
            <ul class="list-disc list-inside space-y-2 text-slate-700">
              <li>
                <span class="font-semibold">2021:</span> Solo exhibition, <span
                  class="font-semibold">Marvin Gallery</span
                >, Madrid, Spain.
              </li>
              <li>
                <span class="font-semibold">2020:</span> Collective exhibition, <span
                  class="font-semibold">Abu Dhabi</span
                >.
              </li>
              <li>
                <span class="font-semibold">2018:</span> Solo exhibition, <span
                  class="font-semibold">Beijing</span
                >, China, at the Public and Cultural Diplomacy Center of China
                and the Uruguayan Embassy.
              </li>
              <li>
                <span class="font-semibold">2017:</span> Collective exhibition, <span
                  class="font-semibold">Crypt Gallery</span
                >, London, United Kingdom.
              </li>
              <li>
                <span class="font-semibold">2016:</span> International Art Fair,
                <span class="font-semibold">Innsbruck</span>, Austria.
              </li>
              <li>
                <span class="font-semibold">2015:</span> Solo exhibition, <span
                  class="font-semibold">Mentana Art Gallery</span
                >, Florence, Italy.
              </li>
            </ul>
          </div>
          <div class="space-y-3">
            <h3 class="text-xl font-medium text-slate-800">Past Exhibitions</h3>
            <ul class="list-disc list-inside space-y-2 text-slate-700">
              <li>
                <span class="font-semibold">2011:</span> Solo exhibition, <span
                  class="font-semibold">Embassy of Uruguay</span
                >, Washington, D.C., USA.
              </li>
              <li>
                <span class="font-semibold">2011:</span> Solo exhibition, <span
                  class="font-semibold">Consulate General of Uruguay</span
                >, New York, USA.
              </li>
              <li>
                <span class="font-semibold">2006:</span> Collective exhibition, <span
                  class="font-semibold">Village Gallery</span
                >, Shanghai, China.
              </li>
              <li>
                <span class="font-semibold">2004:</span> Collective exhibition, <span
                  class="font-semibold">Brazil-USA Cultural Institute</span
                >, São Paulo, Brazil.
              </li>
              <li>
                <span class="font-semibold">2003:</span> Solo exhibition, <span
                  class="font-semibold">Circle of the Union</span
                >, Montevideo, Uruguay.
              </li>
              <li>
                <span class="font-semibold">2002:</span> Solo exhibition, <span
                  class="font-semibold">Art Shop Gallery</span
                >, Kuwait.
              </li>
              <li>
                <span class="font-semibold">2002:</span> Solo exhibition, <span
                  class="font-semibold">Embassy of Venezuela</span
                >, Kuwait.
              </li>
              <li>
                <span class="font-semibold">2000:</span> Collective exhibition, <span
                  class="font-semibold">Embassy of Uruguay</span
                >, Buenos Aires, Argentina.
              </li>
              <li>
                <span class="font-semibold">1995:</span> Collective exhibition, <span
                  class="font-semibold">House of Culture</span
                >, Maldonado, Uruguay.
              </li>
              <li>
                <span class="font-semibold">1987:</span> Collective exhibition, Montevideo,
                Uruguay.
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Collections Section -->
      <section>
        <h2
          class="text-2xl font-light text-slate-800 mb-4 border-b border-slate-200 pb-2"
        >
          Collections
        </h2>
        <p class="text-slate-700">
          Featured in public and private collections in <span
            class="font-semibold"
            >Uruguay, Argentina, Belgium, Kuwait, Lebanon, Spain, China</span
          >, and more.
        </p>
      </section>
    </div>
  </main>
</Layout>

