---
import Composicion2023 from "../../../src/assets/Azul_Prusia/Composicion_2023.jpg";
import Image from "astro/components/Image.astro";
---

<div class="flex flex-col gap-10 mt-10 justify-center items-center wrapper">
  <div class="grid md:grid-cols-2 justify-center items-center gap-8 max-w-7xl mx-auto px-4">
    <p class="md:w-4/5 mx-auto space-y-4">
      <span class="text-lg md:text-3xl font-semibold block mb-4 text-slate-800">Bruno Sfeir</span>
      <span class="text-slate-700 leading-relaxed block">
        is an Uruguayan-Lebanese painter based in Spain. Throughout his extensive career, he has created works
        across various mediums and explored a wide range of themes. His art has traveled
        around the globe, with each piece reflecting a deep internal process rooted
        in meditation.
      </span>
    </p>

    <Image
      src={Composicion2023}
      alt="Bruno Sfeir"
      class="md:w-[650px] hidden md:block rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300"
    />
  </div>
</div>
